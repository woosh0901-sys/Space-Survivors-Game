<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="720.0" style="-fx-background-image: url('/images/start.png'); -fx-background-size: cover; -fx-background-position: center center; -fx-background-repeat: no-repeat;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamestates.MenuController">
   <children>
      <VBox alignment="BOTTOM_CENTER" spacing="20.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            
            <Button onAction="#handlePlayButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 10;" text="START GAME">
               <font>
                  <Font name="Arial Bold" size="24.0" />
               </font>
               <padding>
                  <Insets bottom="12.0" left="30.0" right="30.0" top="12.0" />
               </padding>
               <style>
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 10, 0, 0, 0);
               </style>
            </Button>
            
            <Button onAction="#handleShopButton" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 10;" text="SHOP">
               <font>
                  <Font name="Arial Bold" size="24.0" />
               </font>
               <padding>
                  <Insets bottom="12.0" left="30.0" right="30.0" top="12.0" />
               </padding>
               <style>
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 10, 0, 0, 0);
               </style>
            </Button>
            
            <Button onAction="#handleResetButton" style="-fx-background-color: #888888; -fx-text-fill: white; -fx-background-radius: 10;" text="RESET DATA">
               <font>
                  <Font name="Arial" size="18.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <style>
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 10, 0, 0, 0);
               </style>
            </Button>
         </children>
         <padding>
            <Insets bottom="30.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
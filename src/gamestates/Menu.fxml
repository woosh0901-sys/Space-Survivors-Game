<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="1440.0" prefWidth="1080.0" style="-fx-background-image: url('images/start.png'); -fx-background-size: cover; -fx-background-position: center center; -fx-background-repeat: no-repeat;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamestates.MenuController">
   <children>
      <VBox alignment="BOTTOM_CENTER" spacing="10.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            
            <Button mnemonicParsing="false" onAction="#handlePlayButton" prefHeight="200.0" prefWidth="480.0" 
                    style="-fx-background-color: transparent; -fx-background-image: url('/images/start1.png'); -fx-background-size: 100% 100%; -fx-background-repeat: no-repeat; -fx-cursor: hand; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,1.0), 8, 0.0, 0, 2);" />
            
            <Button mnemonicParsing="false" onAction="#handleShopButton" prefHeight="170.0" prefWidth="350.0" 
                    style="-fx-background-color: transparent; -fx-background-image: url('/images/shop.png'); -fx-background-size: 100% 100%; -fx-background-repeat: no-repeat; -fx-cursor: hand; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,1.0), 8, 0.0, 0, 2);" />
            
            <Button mnemonicParsing="false" onAction="#handleResetButton" prefHeight="160.0" prefWidth="480.0" 
                    style="-fx-background-color: transparent; -fx-background-image: url('/images/reset.png'); -fx-background-size: 100% 100%; -fx-background-repeat: no-repeat; -fx-cursor: hand; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,1.0), 8, 0.0, 0, 2);">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            
         </children>
         <padding>
            <Insets bottom="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1440.0" prefWidth="1080.0" style="-fx-background-image: url('@/images/start.jpg'); -fx-background-size: cover; -fx-background-position: center center;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamestates.GameClearController">
   <children>
      
      <VBox alignment="CENTER" spacing="40.0" style="-fx-background-color: rgba(0, 0, 0, 0.85); -fx-border-color: #00FFFF; -fx-border-width: 4; -fx-background-radius: 30; -fx-border-radius: 30; -fx-effect: dropshadow(three-pass-box, #00FFFF, 50, 0.4, 0, 0);" AnchorPane.bottomAnchor="300.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="300.0">
         <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </padding>
         <children>
            
            <Label text="MISSION COMPLETE" textFill="#00FFFF">
               <font>
                  <Font name="Arial Bold" size="70.0" />
               </font>
               <style>-fx-effect: dropshadow(one-pass-box, #008888, 10, 1.0, 0, 0);</style>
            </Label>
            
            <Label text="지구를 지켜냈습니다!" textFill="WHITE">
               <font>
                  <Font name="Arial" size="32.0" />
               </font>
            </Label>
            
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="CLEAR TIME" textFill="GRAY">
                     <font>
                        <Font name="Arial Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="timeLabel" text="00:00" textFill="#FFD700">
                     <font>
                        <Font name="Arial Bold" size="48.0" />
                     </font>
                     <style>-fx-effect: dropshadow(one-pass-box, rgba(255, 215, 0, 0.5), 10, 0.5, 0, 0);</style>
                  </Label>
               </children>
            </VBox>
            
            <Button mnemonicParsing="false" onAction="#handleMenuButton" prefHeight="80.0" prefWidth="300.0" style="-fx-background-color: #008CBA; -fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 15; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 5);" text="MAIN MENU">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Button>
            
         </children>
      </VBox>
      
   </children>
</AnchorPane>
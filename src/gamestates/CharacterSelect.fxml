<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1440.0" prefWidth="1080.0" style="-fx-background-image: url('/images/background.png'); -fx-background-size: cover; -fx-background-position: center center; -fx-background-repeat: no-repeat;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamestates.CharacterSelectController">
   <children>
      
      <VBox alignment="CENTER" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <Label text="캐릭터 선택" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="80.0" />
               </font>
               <style>
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);
               </style>
            </Label>

            <Button mnemonicParsing="false" onAction="#handleSelectDefault" prefHeight="100.0" prefWidth="600.0" 
                    style="-fx-background-color: rgba(0, 0, 0, 0.6); -fx-border-color: #FF8C00; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="박종화 (체력 증가)">
               <font>
                  <Font name="Arial Bold" size="36.0" />
               </font>
            </Button>

            <Button mnemonicParsing="false" onAction="#handleSelectWoo" prefHeight="100.0" prefWidth="600.0" 
                    style="-fx-background-color: rgba(0, 0, 0, 0.6); -fx-border-color: #FF8C00; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="우서현 (골드 증가)">
               <font>
                  <Font name="Arial Bold" size="36.0" />
               </font>
            </Button>

            <Button mnemonicParsing="false" onAction="#handleSelectLee" prefHeight="100.0" prefWidth="600.0" 
                    style="-fx-background-color: rgba(0, 0, 0, 0.6); -fx-border-color: #FF8C00; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="이정환 (공격력 증가)">
               <font>
                  <Font name="Arial Bold" size="36.0" />
               </font>
            </Button>

            <Button mnemonicParsing="false" onAction="#handleBackButton" prefHeight="60.0" prefWidth="200.0" 
                    style="-fx-background-color: rgba(100, 100, 100, 0.8); -fx-background-radius: 10; -fx-text-fill: white; -fx-cursor: hand;" 
                    text="뒤로가기">
               <font>
                  <Font name="Arial" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
            </Button>

         </children>
      </VBox>
   </children>
</AnchorPane>